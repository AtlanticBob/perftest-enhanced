librdmacm: match RoCE VFs that report a zero node_guid

Applies to rdma-core v54.0 (tested against tag v54.0 exactly).

Some RoCE virtual functions report node_guid = 0. librdmacm's device
matching keys on the guid, so rdma_cm cannot resolve the verbs device for
such a VF and any perftest run using -R fails on it. The kernel does still
return a usable ibdev_index in that case, so this makes match() fall back
to it, and skips the device lookup during the AF_IB support probe, where a
partially initialised id would otherwise bind to the wrong device.

Only affects -R / rdma_cm. Without -R, perftest exchanges addresses over
TCP and never enters this code, so an unpatched rdma-core is fine.

KNOWN REGRESSION - apply only if you have the symptom. On one test host,
a v54.0 built with this patch made -R fail (RDMA_CM_EVENT_REJECTED) on VFs
whose node_guid is NOT zero, while the same build without the patch, and
the distribution's own v54.0, both worked. A second host with non-zero
guids was unaffected, so the trigger is environment dependent and not yet
understood. Treat this as a workaround for a specific failure, not as a
general improvement.

Apply with:

    cd rdma-core-src            # a v54.0 checkout
    git apply /path/to/this/file
    # then rebuild and install as usual

This is not carried by the repository's build system: rdma-core is not
vendored here, and the patch is recorded so the dependency is reproducible
rather than living only in one machine's working tree.

---
diff --git a/librdmacm/cma.c b/librdmacm/cma.c
index 4a13745..4d1ce50 100644
--- a/librdmacm/cma.c
+++ b/librdmacm/cma.c
@@ -145,6 +145,7 @@ static int abi_ver = -1;
 static char dev_name[64] = "rdma_cm";
 static dev_t dev_cdev;
 int af_ib_support;
+static int af_ib_probe;
 static struct index_map ucma_idm;
 static fastlock_t idm_lock;
 
@@ -256,7 +257,9 @@ static void ucma_set_af_ib_support(void)
 	sib.sib_sid = htobe64(RDMA_IB_IP_PS_TCP);
 	sib.sib_sid_mask = htobe64(RDMA_IB_IP_PS_MASK);
 	af_ib_support = 1;
+	af_ib_probe = 1;
 	ret = rdma_bind_addr(id, (struct sockaddr *) &sib);
+	af_ib_probe = 0;
 	af_ib_support = !ret;
 
 	rdma_destroy_id(id);
@@ -420,11 +423,20 @@ err1:
 
 static bool match(struct cma_device *cma_dev, __be64 guid, uint32_t idx)
 {
-	if ((idx == UCMA_INVALID_IB_INDEX) ||
-	    (cma_dev->ibv_idx == UCMA_INVALID_IB_INDEX))
-		return cma_dev->guid == guid;
+	if ((idx != UCMA_INVALID_IB_INDEX) &&
+	    (cma_dev->ibv_idx != UCMA_INVALID_IB_INDEX)) {
+		if (cma_dev->ibv_idx != idx)
+			return false;
 
-	return cma_dev->ibv_idx == idx && cma_dev->guid == guid;
+		/*
+		 * Some RoCE VFs report a zero node_guid. In that case the
+		 * kernel can still return a valid ibdev_index, which is enough
+		 * to identify the verbs device.
+		 */
+		return !guid || cma_dev->guid == guid;
+	}
+
+	return guid && cma_dev->guid == guid;
 }
 
 static int ucma_init_device(struct cma_device *cma_dev)
@@ -884,7 +896,8 @@ static int ucma_query_addr(struct rdma_cm_id *id)
 	memcpy(&id->route.addr.src_addr, &resp.src_addr, resp.src_size);
 	memcpy(&id->route.addr.dst_addr, &resp.dst_addr, resp.dst_size);
 
-	if (!id_priv->cma_dev && resp.node_guid) {
+	if (!id_priv->cma_dev && !af_ib_probe &&
+	    (resp.node_guid || resp.ibdev_index != UCMA_INVALID_IB_INDEX)) {
 		ret = ucma_get_device(id_priv, resp.node_guid,
 				      resp.ibdev_index);
 		if (ret)
@@ -1035,7 +1048,8 @@ static int ucma_query_route(struct rdma_cm_id *id)
 	memcpy(&id->route.addr.dst_addr, &resp.dst_addr,
 	       sizeof resp.dst_addr);
 
-	if (!id_priv->cma_dev && resp.node_guid) {
+	if (!id_priv->cma_dev && !af_ib_probe &&
+	    (resp.node_guid || resp.ibdev_index != UCMA_INVALID_IB_INDEX)) {
 		ret = ucma_get_device(id_priv, resp.node_guid,
 				      resp.ibdev_index);
 		if (ret)
